      m_Calls: []
  m_text: 'During any base game spin, there is a chance 2-5 random Moonwalk Wilds
    will appear anywhere on reels 2-

    5. Moonwalk Wilds substitute for all symbols
    except BONUS and JACKPOT. If a BONUS or JACKPOT symbol would land in a space
    where a Moonwalk Wild appears, it counts as both a Moonwalk Wild and that symbol.

    One
    or more Moonwalk Wilds in a winning combination on an active payline doubles
    the pay.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: e67b3fb261856431daf17acf5ee3cc7d, type: 2}
